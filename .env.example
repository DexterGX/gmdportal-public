```bash
# Copy to .env.local and fill in
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=changeme-long-random-string


# Google OAuth (create creds at console.cloud.google.com)
AUTH_GOOGLE_ID=YOUR_GOOGLE_CLIENT_ID
AUTH_GOOGLE_SECRET=YOUR_GOOGLE_CLIENT_SECRET


# Optional: restrict to your Workspace domain
ALLOWED_GOOGLE_DOMAIN=gmdesignusa.com


# Cabinet price list import (AI-assisted parsing) - console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your-key-here
```