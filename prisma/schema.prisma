  slabAreaLabel  String? // free text like "1) 127 X 64 = 50.80"
  slabQty        Int      @default(0)
  slabRecommendedQty Int  @default(0)
  slabQtyFlagged Boolean  @default(false)
  slabTypeId     String?
  slabType       FabricationSlabTypeOption? @relation(fields: [slabTypeId], references: [id])
  slabAmount     Decimal  @default(0) @db.Decimal(12, 2) // price we're selling the slab for

  jobSqft Decimal @default(0) @db.Decimal(10, 2)
  labor   Decimal @default(0) @db.Decimal(12, 2)
  buildUp Decimal @default(0) @db.Decimal(12, 2)

