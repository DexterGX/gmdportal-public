// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  SALES
  OFFICE
  FINANCE
  SPECIALIST
  INSTALLER
  UNASSIGNED
}

model User {
  id                String    @id @default(cuid())
  name              String?
  email             String?   @unique
  emailVerified     DateTime?
  image             String?

  // For credentials login
  username          String?   @unique
  passwordHash      String?

  // For password reset
  resetToken        String?   @unique
  resetTokenExpiry  DateTime?

  // Role-based access
  role              Role      @default(UNASSIGNED)
  active            Boolean   @default(false)

  accounts          Account[]
  sessions          Session[]
  
  // Closet quote relations
  installerQuotes   ClosetQuote[] @relation("InstallerQuotes")
  submittedQuotes   ClosetQuote[] @relation("SubmittedQuotes")
  approvedQuotes    ClosetQuote[] @relation("ApprovedQuotes")
}

model Account {
  id                String   @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?  @db.Text
  access_token      String?  @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?  @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model StockItem {
  id           String             @id @default(uuid())
  name         String
  category     String
  unit         String
  quantity     Int                @default(0)
  minQuantity  Int                @default(0)
  providor     String?
  notes        String?
  updatedById  String?
  updatedAt    DateTime           @updatedAt
  transactions StockTransaction[]
}

model StockTransaction {
  id          String    @id @default(uuid())
  itemId      String
  userId      String?
  change      Int
  reason      String?
  oldQuantity Int
  newQuantity Int
  createdAt   DateTime  @default(now())

  item StockItem @relation(fields: [itemId], references: [id])
}

// ======================================================================
// SLAB MANAGEMENT MODELS
// ======================================================================

enum SlabThickness {
  EIGHT_MM
  TWELVE_MM
  TWO_CM
  THREE_CM
}

enum SlabStatus {
  AVAILABLE
  UNAVAILABLE
  DISCONTINUED
}

enum SlabFinish {
  CONCRETE
  DUAL
  HONED
  LEATHER
  MATTE
  NATURAL
  OTHER
  POLISHED
  ROUGH
  STONE
  ULTRA_ROUGH
  SATIN
  SATIN_HONED
  PATINATO
  LEVIGATO_PEARL
  GLAM
  GINZA
  HOLOS
  TWILL
  JUTA
  DENIM
  DAMIER
  LAVA
  SILK
  LUXE
  BRUSHED
  TEXTURED
  SMOOTH_MATTE
  TEXTURED_MATTE
  VELVET
  TEXTURED_VELVET
  SATIN_RIDGE
}

model SlabBrandConfig {
  id             String   @id @default(cuid())
  brandNumber    Int?     @unique // Numeric brand ID
  name           String          // "Caesarstone", "Silestone", etc.
  gmdBrandId     String?         // optional internal code

  profitFactor   Decimal @db.Decimal(10, 4) // e.g. 1.3500
  taxRate        Decimal @db.Decimal(5, 4)  // e.g. 0.0700 (7%)
  deliveryFee    Decimal @db.Decimal(10, 2) // flat fee per slab
  discount       Decimal @db.Decimal(10, 4) // optional discount factor

  lastUpdate     DateTime? @db.Timestamptz

  contactName    String?
  contactNumber  String?  // office phone
  contactCell    String?  // cell / WhatsApp
  contactEmail   String?
  logoUrl        String?  // public URL for brand logo

  slabs          Slab[]

  createdAt      DateTime @default(now()) @db.Timestamptz
  updatedAt      DateTime @updatedAt @db.Timestamptz
}

model Slab {
  id             String   @id @default(cuid())
  slabNumber     Int?     @unique // Numeric slab ID
  gmdId          String?        // optional internal GM Design ID

  brand          SlabBrandConfig @relation(fields: [brandId], references: [id])
  brandId        String

  series         String?
  providerCode   String         // code from provider price list
  color          String
  finish         SlabFinish

  widthIn        Decimal  @db.Decimal(6, 2) // Width in inches
  heightIn       Decimal  @db.Decimal(6, 2) // Height in inches
  thickness      SlabThickness

  status         SlabStatus @default(AVAILABLE)

  providerPrice  Decimal @db.Decimal(10, 2) // raw price from provider
  finalPrice     Decimal @db.Decimal(10, 2) // computed sale price

  createdAt      DateTime @default(now()) @db.Timestamptz
  updatedAt      DateTime @updatedAt @db.Timestamptz
}

// ======================================================================
// CLOSET ESTIMATE PROGRAM MODELS
// ======================================================================

enum ClosetAreaType {
  MASTER
  GUEST
  GARAGE
  KITCHEN
  WALL_UNIT
  LAUNDRY
  OTHER
}

enum ClosetJobStatus {
  QUOTE      // Job created, waiting for installer quotes
  REVIEW     // Installer quotes submitted, waiting for review
  APPROVED   // At least one quote approved
  CANCELLED
}

enum ClosetQuoteStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

model ClosetJob {
  id              String           @id @default(uuid())
  quoteNumber     String           @unique   // e.g. DG-CQUO-250315-001

  // Foreign keys to existing User model
  customerName    String           // Store customer name directly (no separate Customer model)
  customerPhone   String?
  salesPersonId   String
  installerId     String           // assigned installer (INSTALLER role)

  propertyAddress String
  area            ClosetAreaType

  status          ClosetJobStatus  @default(QUOTE)

  createdAt       DateTime         @default(now())
  quoteStartedAt  DateTime         @default(now())

  notesSales      String?

  quotes          ClosetQuote[]
}

model ClosetQuote {
  id              String             @id @default(uuid())
  closetJobId     String
  closetJob       ClosetJob          @relation(fields: [closetJobId], references: [id], onDelete: Cascade)

  // Quote identifier for the job, e.g. T3-CQUO-251212-001-Q2
  quoteCode       String             @unique

  color           String

  // Raw cost from installer – INTERNAL ONLY (do not show in client view)
  installerCost   Decimal            @db.Decimal(12, 2)

  // Factor used to derive final client price (optional, can be null if we only
  // store the finalPrice)
  gmFactor        Decimal?           @db.Decimal(8, 4)

  // Final price shown to client
  finalPrice      Decimal            @db.Decimal(12, 2)

  // Installer responsible for this quote (optional for migration)
  installerId     String?
  installer       User?              @relation("InstallerQuotes", fields: [installerId], references: [id])

  notesInstaller  String?
  notesSales      String?

  status          ClosetQuoteStatus  @default(PENDING_REVIEW)

  createdAt       DateTime           @default(now())
  submittedAt     DateTime?

  // Who actually submitted (could be installer or admin) (optional for migration)
  submittedById   String?
  submittedBy     User?              @relation("SubmittedQuotes", fields: [submittedById], references: [id])

  approvedAt      DateTime?
  approvedById    String?
  approvedBy      User?              @relation("ApprovedQuotes", fields: [approvedById], references: [id])

  lastPrintedAt   DateTime?
  lastPrintedById String?

  files           ClosetQuoteFile[]
}

model ClosetQuoteFile {
  id            String       @id @default(uuid())
  closetQuoteId String
  closetQuote   ClosetQuote  @relation(fields: [closetQuoteId], references: [id], onDelete: Cascade)

  fileUrl       String
  type          String       // e.g. "3D_RENDER", "PLAN", "PHOTO"
  caption       String?

  uploadedById  String
  uploadedAt    DateTime     @default(now())
}

model ClosetEstimateSettings {
  id                    String   @id @default(uuid())
  defaultGmFactor       Decimal  @db.Decimal(8, 4) // e.g. 1.3500
  quoteNumberFormat     String   @default("{INITIALS}-CQUO-{YYMMDD}-{SEQ3}")
  
  // Layout settings for print/PDF
  printLogoUrl          String   @default("/logo.svg")
  printCompanyName      String   @default("GM Design")
  printCompanyLine1     String   @default("Custom Closets & Cabinetry")
  printCompanyLine2     String   @default("Miami, FL")
  printCompanyPhone     String   @default("(305) XXX-XXXX")
  printHeaderTitle      String   @default("Closet Design & Installation Quote")
  printOverviewTemplate String   @default("Custom closet system for the {AREA} at {ADDRESS}, including design, materials, and professional installation as illustrated in the 3D views below.")
  
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}
