// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  SALES
  OFFICE
  FINANCE
  SPECIALIST
  UNASSIGNED
}

model User {
  id                String    @id @default(cuid())
  name              String?
  email             String?   @unique
  emailVerified     DateTime?
  image             String?

  // For credentials login
  username          String?   @unique
  passwordHash      String?

  // For password reset
  resetToken        String?   @unique
  resetTokenExpiry  DateTime?

  // Role-based access
  role              Role      @default(UNASSIGNED)
  active            Boolean   @default(false)

  accounts          Account[]
  sessions          Session[]
}

model Account {
  id                String   @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?  @db.Text
  access_token      String?  @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?  @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model StockItem {
  id           String             @id @default(uuid())
  name         String
  category     String
  unit         String
  quantity     Int                @default(0)
  minQuantity  Int                @default(0)
  providor     String?
  notes        String?
  updatedById  String?
  updatedAt    DateTime           @updatedAt
  transactions StockTransaction[]
}

model StockTransaction {
  id          String    @id @default(uuid())
  itemId      String
  userId      String?
  change      Int
  reason      String?
  oldQuantity Int
  newQuantity Int
  createdAt   DateTime  @default(now())

  item StockItem @relation(fields: [itemId], references: [id])
}

// ======================================================================
// SLAB MANAGEMENT MODELS
// ======================================================================

enum SlabThickness {
  EIGHT_MM
  TWELVE_MM
  TWO_CM
  THREE_CM
}

enum SlabStatus {
  AVAILABLE
  UNAVAILABLE
  DISCONTINUED
}

enum SlabFinish {
  CONCRETE
  DUAL
  HONED
  LEATHER
  MATTE
  NATURAL
  OTHER
  POLISHED
  ROUGH
  STONE
  ULTRA_ROUGH
  SATIN
  SATIN_HONED
  PATINATO
  LEVIGATO_PEARL
  GLAM
  GINZA
  HOLOS
  TWILL
  JUTA
  DENIM
  DAMIER
  LAVA
}

model SlabBrandConfig {
  id             String   @id @default(cuid())
  brandNumber    Int?     @unique // Numeric brand ID
  name           String          // "Caesarstone", "Silestone", etc.
  gmdBrandId     String?         // optional internal code

  profitFactor   Decimal @db.Decimal(10, 4) // e.g. 1.3500
  taxRate        Decimal @db.Decimal(5, 4)  // e.g. 0.0700 (7%)
  deliveryFee    Decimal @db.Decimal(10, 2) // flat fee per slab
  discount       Decimal @db.Decimal(10, 4) // optional discount factor

  lastUpdate     DateTime? @db.Timestamptz

  contactName    String?
  contactNumber  String?  // office phone
  contactCell    String?  // cell / WhatsApp
  contactEmail   String?
  logoUrl        String?  // public URL for brand logo

  slabs          Slab[]

  createdAt      DateTime @default(now()) @db.Timestamptz
  updatedAt      DateTime @updatedAt @db.Timestamptz
}

model Slab {
  id             String   @id @default(cuid())
  slabNumber     Int?     @unique // Numeric slab ID
  gmdId          String?        // optional internal GM Design ID

  brand          SlabBrandConfig @relation(fields: [brandId], references: [id])
  brandId        String

  series         String?
  providerCode   String         // code from provider price list
  color          String
  finish         SlabFinish

  widthIn        Decimal  @db.Decimal(6, 2) // Width in inches
  heightIn       Decimal  @db.Decimal(6, 2) // Height in inches
  thickness      SlabThickness

  status         SlabStatus @default(AVAILABLE)

  providerPrice  Decimal @db.Decimal(10, 2) // raw price from provider
  finalPrice     Decimal @db.Decimal(10, 2) // computed sale price

  createdAt      DateTime @default(now()) @db.Timestamptz
  updatedAt      DateTime @updatedAt @db.Timestamptz
}
