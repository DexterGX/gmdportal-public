  price  Decimal            @db.Decimal(12, 2)

  @@unique([itemId, tierId])
  @@index([tierId])
}

// GMD Parameters (round 9) - admin-tunable numbers that drive the
// Installation auto-calculation, edited from /cabinet-estimates/parameters.
// Every numeric default below that Diego did not explicitly confirm seeds
// to 0 on purpose (see project memory, round 9) - visibly "unset" rather
// than a guessed real-money default.
model CabinetEstimateParameters {
  id                      String   @id @default(cuid())
  // Whole-number percents (15 = 15%), same convention as
  // CabinetEstimate.discountPercent and CabinetEstimateLineItem.customizationValue
  // elsewhere in this program - NOT the 0-1 fraction convention used by
  // CabinetProviderSettings.discount/.factor (a different, vendor-pricing concern).
  installationBasePercent Decimal  @default(15) @db.Decimal(6, 2) // 15% - confirmed by Diego
  installationCalcMode    String   @default("higher") // "flat" | "perItem" | "higher" - confirmed default
  customSurchargePercent  Decimal  @default(0) @db.Decimal(6, 2) // NOT confirmed - set via GMD Parameters
  updatedAt               DateTime @updatedAt
  // Singleton row - same findFirst-or-create pattern as MiscWallUnitSetting.
}

model CabinetInstallationType {
  id         String            @id @default(cuid())
  name       String            @unique
  multiplier Decimal           @default(1) @db.Decimal(6, 4)
  sortOrder  Int               @default(0)
  isActive   Boolean           @default(true)
  estimates  CabinetEstimate[]
  // Seeded: Standard 1.0, Special 1.5, Custom 2.0 - confirmed by Diego.
}

model CabinetRemovalType {
  id         String            @id @default(cuid())
  name       String            @unique
  // Whole-number percent (10 = 10%), same convention as
  // CabinetEstimateParameters.installationBasePercent elsewhere in this
  // program - NOT confirmed/seeded with any real value by Diego, this
  // list starts empty and he fills it in himself via GMD Parameters.
  percent    Decimal           @default(0) @db.Decimal(6, 2)
  sortOrder  Int               @default(0)
  isActive   Boolean           @default(true)
  estimates  CabinetEstimate[]
}

// Round 12: for now this is just a manageable list of names for the
// header's Project Type dropdown - no calculation tied to it (per Diego's
// explicit "for now just make me able to add items to the dropdown"), so
// CabinetEstimate.projectType stays a plain denormalized string (like
// removal/brand/groupColor) with no FK to this table.
model CabinetProjectType {
  id        String   @id @default(cuid())
  name      String   @unique
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
}

model CabinetEstimate {
  id             String   @id @default(cuid())
  estimateNumber String?  @unique
  date           DateTime @default(now())

  // Header (mirrors the printed estimate sheet's top block)
  customerName String
  customerId   String? // loose link to Customer.id - best-effort, not a DB relation (see FabricationOrder.clientId)
  jobId        String?
  job          Job?    @relation(fields: [jobId], references: [id])
  jobName      String?
  jobAddress   String?
  email        String?
  dealId       String?
  dealName     String?
  salesRep     String
  brand        String?
  groupColor   String?
  vendorId     String?
  vendor       CabinetVendor?    @relation(fields: [vendorId], references: [id])
  priceTierId  String?
  priceTier    CabinetPriceTier? @relation(fields: [priceTierId], references: [id])
  removal      String?
  projectType  String?
  version      String?

  // Round 9: which GMD Parameters Installation Type was billed - snapshotted
  // (denormalized name, same idea as brand/groupColor) so print/history keep
  // reading a plain string even if the type is later renamed/deactivated.
  installationTypeId   String?
  installationType     CabinetInstallationType? @relation(fields: [installationTypeId], references: [id])
  installationTypeName String?

  // Round 12: which GMD Parameters Removal Type was billed - the existing
  // `removal` column (above) is the denormalized name snapshot, same
  // pattern as installationTypeName. removalAmount (below) is now always
  // server-computed from removalType.percent x cabinetsTotal (pre-discount),
  // never a typed dollar amount.
  removalTypeId String?
  removalType   CabinetRemovalType? @relation(fields: [removalTypeId], references: [id])

  // Footer - "CABINETS CATEGORY" box - auto-computed by the form from
  // lineItems.summaryBucket (sum of qty per bucket); stored here so
  // history/PATCH/print keep reading a plain column, same as cabinetsTotal.
  standardCabinetsCount Int     @default(0)
  doubleCabinetsCount   Int     @default(0)
  customCabinetsCount   Int     @default(0)
  miscCabinetsCount     Int     @default(0)
  itemsQuantity         Int     @default(0)
  microwaveInstallation Boolean @default(false)

  // Footer - price distribution: Cabinets -> Discount -> Subtotal -> Removal
  // -> Installation -> Customization -> Total
  cabinetsTotal       Decimal @default(0) @db.Decimal(12, 2) // auto: sum of line items
  discountPercent     Int     @default(0) // 0/5/10/15/20/25 - 25 = "Contractor" tier
  discount            Decimal @default(0) @db.Decimal(12, 2) // auto: cabinetsTotal * discountPercent / 100
  cabinetsSubtotal    Decimal @default(0) @db.Decimal(12, 2) // auto: cabinetsTotal - discount
  removalAmount       Decimal @default(0) @db.Decimal(12, 2)
  installationAmount  Decimal @default(0) @db.Decimal(12, 2)
  customizationLabel  String?
  customizationAmount Decimal @default(0) @db.Decimal(12, 2)
  total               Decimal @default(0) @db.Decimal(12, 2) // auto: cabinetsSubtotal + removal + installation + customization

  notes       String?
  isActive    Boolean  @default(true)
  createdById String?
  createdBy   User?    @relation("CabinetEstimateCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lineItems CabinetEstimateLineItem[]
  history   CabinetEstimateHistory[]
  specialCustomizationLines CabinetEstimateSpecialCustomizationLine[]

  @@index([estimateNumber])
  @@index([customerId])
  @@index([jobId])
  @@index([isActive])
  @@index([vendorId])
  @@index([priceTierId])
  @@index([installationTypeId])
}

model CabinetEstimateLineItem {
  id         String          @id @default(cuid())
  estimateId String
  estimate   CabinetEstimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)

  sortOrder   Int     @default(0)
  qty             Decimal @default(1) @db.Decimal(10, 2)
  code            String?
  description     String?
  isCustomization Boolean @default(false)
  // Only meaningful when isCustomization is true - the extra Installation
  // surcharge for building this item custom, either a percent of the
  // line's own qty*unitPrice or a flat $ amount per unit. Never rolled
  // into this line's own totalPrice/Cabinets total - it's added to the
  // estimate's Installation total instead (see cabinetEstimateCalc.ts).
  customizationType  String? // "percent" | "flat"
  customizationValue Decimal @default(0) @db.Decimal(10, 2)
  catalogItemId String?
  catalogItem   CabinetCatalogItem?   @relation(fields: [catalogItemId], references: [id])
  summaryBucket CabinetSummaryBucket?
  // Round 11: snapshotted from the catalog item's installationItemId at
  // code-selection time (and refreshed on re-price), same pattern as
  // summaryBucket - drives the per-item Installation calc via the
  // Installers Price Table instead of a flat per-bucket rate.
  installationItemId String?
  installationItem    CabinetInstallationServiceItem? @relation(fields: [installationItemId], references: [id])
  note            String?
  unitPrice       Decimal @default(0) @db.Decimal(12, 2)
  totalPrice      Decimal @default(0) @db.Decimal(12, 2)

  @@index([estimateId])
  @@index([catalogItemId])
  @@index([installationItemId])
}

model CabinetSpecialCustomizationItem {
  id        String   @id @default(cuid())
  name      String
  price     Decimal  @default(0) @db.Decimal(12, 2)
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines CabinetEstimateSpecialCustomizationLine[]

  @@index([isActive])
  @@index([sortOrder])
}

model CabinetEstimateSpecialCustomizationLine {
  id         String          @id @default(cuid())
  estimateId String
  estimate   CabinetEstimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  itemId     String
  item       CabinetSpecialCustomizationItem @relation(fields: [itemId], references: [id])

  qty    Decimal @default(0) @db.Decimal(10, 2)
  amount Decimal @default(0) @db.Decimal(12, 2) // auto: qty * item.price at save time

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([estimateId, itemId])
  @@index([estimateId])
  @@index([itemId])
}

model CabinetEstimateHistory {
  id         String          @id @default(cuid())
  estimateId String
  estimate   CabinetEstimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)

  action    String // CREATED, UPDATED, ARCHIVED, RESTORED, DELETED
  fieldName String?
  oldValue  String?
  newValue  String?

  changedById   String?
  changedByUser User?    @relation("CabinetEstimateHistoryChangedBy", fields: [changedById], references: [id])
  createdAt     DateTime @default(now())

  @@index([estimateId])
  @@index([createdAt])
}

model FabricationPriceChangeLog {
  id         String @id @default(cuid())
  entityType String // "EdgeType","SinkCutout","Cooktop","BumpOut","CuttingBoard","Windowsill","PowerStation","OtherCharge","Removal","SlabType"
  entityId   String
  entityName String
  fieldName  String
  oldValue   String?
  newValue   String?

  changedById   String?
  changedByUser User?    @relation("FabricationPriceChangeLogChangedBy", fields: [changedById], references: [id])
  createdAt     DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

// === Vehicles (fleet maintenance) ===

model VehicleDriver {
  id        String   @id @default(cuid())
  name      String   @unique
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vehiclesAsDefaultDriver Vehicle[]           @relation("VehicleDefaultDriver")
  inspections             VehicleInspection[] @relation("VehicleInspectionDriver")

  @@index([active])
}

model Vehicle {
  id             String  @id @default(cuid())
  internalNumber String? @unique
  name           String
  year           Int?
  color          String?
  plate          String?
  hasPlate       Boolean @default(true) // false for equipment with no plate (forklifts, etc.)
  sunpass        String?
  hasSunpass     Boolean @default(true)
  filter         String?
  oil            String?
  notes          String?

  defaultDriverId String?
  defaultDriver   VehicleDriver? @relation("VehicleDefaultDriver", fields: [defaultDriverId], references: [id])

  oilChangeIntervalMiles Int @default(5000) // miles allowed before the next oil/filter change
  lastOilChangeMileage   Int @default(0) // baseline; only moves when an oil change is completed

  // Cached maintenance status, recomputed and persisted whenever a new
  // inspection is logged, an oil change is completed, an inspection is
  // deleted, or the interval/baseline is edited. Kept denormalized because
  // "currentMileage >= nextChangeMileage" is a same-row field comparison
  // that Prisma's query builder cannot express in a `where` filter, so the
  // dashboard's "needs immediate change" list needs a plain indexed boolean.
  currentMileage       Int       @default(0)
  nextChangeMileage    Int       @default(5000)
  milesRemaining       Int?
  milesExceeded        Int?
  needsImmediateChange Boolean   @default(false)
  lastInspectionAt     DateTime?

  isActive    Boolean  @default(true)
  createdById String?
  createdBy   User?    @relation("VehicleCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  inspections VehicleInspection[]
  history     VehicleHistory[]

  @@index([isActive])
  @@index([name])
  @@index([needsImmediateChange])
  @@index([defaultDriverId])
}

model VehicleInspection {
  id          String         @id @default(cuid())
  vehicleId   String
  vehicle     Vehicle        @relation(fields: [vehicleId], references: [id])
  inspectedAt DateTime       @default(now())
  driverId    String?
  driver      VehicleDriver? @relation("VehicleInspectionDriver", fields: [driverId], references: [id])
  mileage     Int

  // Daily condition checks — distinct from the mileage-interval oil *change*
  // calculation below. `oilLevelOk` means "oil looked fine today", unrelated
  // to whether an oil *change* is due.
  waterLevelOk Boolean?
  oilLevelOk   Boolean?
  tiresOk      Boolean?
  sunpassOk    Boolean?

  conditionNote String?
  repairNote    String?

  // Frozen snapshot of the maintenance calc at the time of this inspection —
  // never recomputed later. Reproduces the source spreadsheet's behavior
  // where consecutive rows repeat the same "next change" value until a real
  // oil change moves the baseline forward.
  oilChangeIntervalAtInspection    Int
  lastOilChangeMileageAtInspection Int
  nextChangeMileage                Int
  filterAtInspection               String?
  milesRemaining                   Int?
  milesExceeded                    Int?
  immediateChangeRequired          Boolean @default(false)

  isOilChangeEvent Boolean  @default(false) // true = this row is a "Complete Immediate Change" action
  isActive         Boolean  @default(true)
  createdById      String?
  createdBy        User?    @relation("VehicleInspectionCreatedBy", fields: [createdById], references: [id])
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([vehicleId, inspectedAt])
  @@index([inspectedAt])
  @@index([immediateChangeRequired])
  @@index([isActive])
  @@index([driverId])
}

model VehicleHistory {
  id        String  @id @default(cuid())
  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  action    String // CREATED, UPDATED, ARCHIVED, RESTORED, OIL_CHANGE_COMPLETED, DELETED
  fieldName String?
  oldValue  String?
  newValue  String?

  changedById   String?
  changedByUser User?    @relation("VehicleHistoryChangedBy", fields: [changedById], references: [id])
  createdAt     DateTime @default(now())

  @@index([vehicleId])
  @@index([createdAt])
}

model VehicleProgramSettings {
  id                             String   @id @default(cuid())
  defaultOilChangeIntervalMiles  Int      @default(5000)
  dueSoonThresholdMiles          Int      @default(500)
  createdAt                      DateTime @default(now())
  updatedAt                      DateTime @updatedAt
}
