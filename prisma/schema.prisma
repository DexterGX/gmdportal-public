  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  areas   FabricationOrderArea[]
  history FabricationOrderHistory[]

  @@index([clientName])
  @@index([isActive])
  @@index([orderNumber])
  @@index([jobId])
}

