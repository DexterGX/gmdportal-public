  date          DateTime @default(now())
  clientName    String
  clientId      String?
  dealId        String?
  dealName      String?
  jobId         String?
  job           Job?     @relation(fields: [jobId], references: [id])
  // Points at the JobArtifact row (see Job.artifacts) that surfaces this
  // order in the Customers program's job Documents list. Kept as a loose id
