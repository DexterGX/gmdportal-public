// Prisma schema
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id               String        @id @default(cuid())
  name             String?
  email            String?       @unique
  emailVerified    DateTime?
  image            String?
  username         String?       @unique
  passwordHash     String?
  resetToken       String?       @unique
  resetTokenExpiry DateTime?
  role             Role          @default(UNASSIGNED)
  active           Boolean       @default(false)
  accounts         Account[]
  approvedQuotes   ClosetQuote[] @relation("ApprovedQuotes")
  installerQuotes  ClosetQuote[] @relation("InstallerQuotes")
  submittedQuotes  ClosetQuote[] @relation("SubmittedQuotes")
  sessions         Session[]
  accessoryTrackersCreated AccessoryTracker[] @relation("AccessoryTrackerCreatedBy")
  accessoryTrackersUpdated AccessoryTracker[] @relation("AccessoryTrackerUpdatedBy")
  accessoryItemsCreated    AccessoryItem[]    @relation("AccessoryItemCreatedBy")
  accessoryItemsUpdated    AccessoryItem[]    @relation("AccessoryItemUpdatedBy")
  accessoryItemsAssigned   AccessoryItem[]    @relation("AccessoryItemAssignedTo")
  accessoryItemEventsChanged   AccessoryItemEvent[]   @relation("AccessoryItemEventChangedBy")
  sampleRequestsRequested      SampleRequest[]        @relation("SampleRequestRequestedBy")
  sampleRequestHistoryChanged  SampleRequestHistory[] @relation("SampleRequestHistoryChangedBy")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model StockItem {
  id           String             @id @default(uuid())
  name         String
  category     String
  unit         String
  quantity     Int                @default(0)
  minQuantity  Int                @default(0)
  notes        String?
  updatedById  String?
  updatedAt    DateTime           @updatedAt
  providor     String?
  transactions StockTransaction[]
}

model StockTransaction {
  id          String    @id @default(uuid())
  itemId      String
  userId      String?
  change      Int
  reason      String?
  oldQuantity Int
  newQuantity Int
  createdAt   DateTime  @default(now())
  item        StockItem @relation(fields: [itemId], references: [id])
}

model SlabBrandConfig {
  id            String    @id @default(cuid())
  name          String
  gmdBrandId    String?
  profitFactor  Decimal   @db.Decimal(10, 4)
  taxRate       Decimal   @db.Decimal(5, 4)
  deliveryFee   Decimal   @db.Decimal(10, 2)
  discount      Decimal   @db.Decimal(10, 4)
  lastUpdate    DateTime? @db.Timestamptz(6)
  contactName   String?
  contactNumber String?
  contactCell   String?
  contactEmail  String?
  createdAt     DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(6)
  brandNumber   Int?      @unique
  logoUrl       String?
  slabs         Slab[]
}

model Slab {
  id            String          @id @default(cuid())
  gmdId         String?
  brandId       String
  series        String?
  providerCode  String
  color         String
  finish        SlabFinish
  status        SlabStatus      @default(AVAILABLE)
  providerPrice Decimal         @db.Decimal(10, 2)
  finalPrice    Decimal         @db.Decimal(10, 2)
  createdAt     DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime        @updatedAt @db.Timestamptz(6)
  heightIn      Decimal         @db.Decimal(6, 2)
  slabNumber    Int?            @unique
  thickness     SlabThickness
  widthIn       Decimal         @db.Decimal(6, 2)
  brand         SlabBrandConfig @relation(fields: [brandId], references: [id])
}

model SlabBayRack {
  id                   String        @id
  name                 String
  capacity             Int
  note                 String?
  countTowardInventory Boolean       @default(true)
  targetFill           Int           @default(5)
  slabs                SlabBaySlab[]
}


model SlabBaySlab {
  id         String   @id
  scannerId  String
  name       String
  type       String
  thickness  String
  size       String
  clientName String
  brand      String?
  finish     String?
  notes      String?
  jobId      String?
  batchId    String?
  batchIndex Int?
  batchSize  Int?
  rackId     String
  createdAt  DateTime @default(now())
  rack       SlabBayRack @relation(fields: [rackId], references: [id])
}

model SlabBayHistory {
  id            String   @id
  type          String
  slabId        String
  slabScannerId String?
  batchId       String?
  batchIndex    Int?
  batchSize     Int?
  slabName      String
  slabType      String
  slabThickness String?
  slabSize      String?
  slabNotes     String?
  slabCreatedAt String?
  clientName    String
  brand         String?
  finish        String?
  jobId         String?
  entryNote     String?
  fromRack      String?
  toRack        String?
  exitNote      String?
  recoveredFromHistoryId String?
  userName      String
  timestamp     String
}

model ClosetJob {
  id              String          @id @default(uuid())
  quoteNumber     String          @unique
  jobId           String?         @unique
  job             Job?            @relation(fields: [jobId], references: [id])
  customerId      String?
  customer        Customer?       @relation(fields: [customerId], references: [id])
  customerName    String
  customerPhone   String?
  salesPersonId   String
  installerId     String
  propertyAddress String
  area            ClosetAreaType
  status          ClosetJobStatus @default(QUOTE)
  createdAt       DateTime        @default(now())
  quoteStartedAt  DateTime        @default(now())
  notesSales      String?
  quotes          ClosetQuote[]
}

model ClosetQuote {
  id              String            @id @default(uuid())
  closetJobId     String
  quoteCode       String            @unique
  color           String
  installerCost   Decimal           @db.Decimal(12, 2)
  gmFactor        Decimal?          @db.Decimal(8, 4)
  finalPrice      Decimal           @db.Decimal(12, 2)
  notesInstaller  String?
  notesSales      String?
  status          ClosetQuoteStatus @default(PENDING_REVIEW)
  createdAt       DateTime          @default(now())
  submittedAt     DateTime?
  approvedAt      DateTime?
  approvedById    String?
  lastPrintedAt   DateTime?
  lastPrintedById String?
  installerId     String?
  submittedById   String?
  approvedBy      User?             @relation("ApprovedQuotes", fields: [approvedById], references: [id])
  closetJob       ClosetJob         @relation(fields: [closetJobId], references: [id], onDelete: Cascade)
  installer       User?             @relation("InstallerQuotes", fields: [installerId], references: [id])
  submittedBy     User?             @relation("SubmittedQuotes", fields: [submittedById], references: [id])
  files           ClosetQuoteFile[]
}

model ClosetQuoteFile {
  id            String      @id @default(uuid())
  closetQuoteId String
  fileUrl       String
  type          String
  caption       String?
  uploadedById  String
  uploadedAt    DateTime    @default(now())
  closetQuote   ClosetQuote @relation(fields: [closetQuoteId], references: [id], onDelete: Cascade)
}

model ClosetEstimateSettings {
  id                    String   @id @default(uuid())
  defaultGmFactor       Decimal  @db.Decimal(8, 4)
  quoteNumberFormat     String   @default("{INITIALS}-CQUO-{YYMMDD}-{SEQ3}")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  printCompanyLine1     String   @default("Custom Closets & Cabinetry")
  printCompanyLine2     String   @default("Miami, FL")
  printCompanyName      String   @default("GM Design")
  printCompanyPhone     String   @default("(305) XXX-XXXX")
  printHeaderTitle      String   @default("Closet Design & Installation Quote")
  printLogoUrl          String   @default("/logo.svg")
  printOverviewTemplate String   @default("Custom closet system for the {AREA} at {ADDRESS}, including design, materials, and professional installation as illustrated in the 3D views below.")
}

model CompanyDocumentSettings {
  id          String   @id @default(cuid())
  companyName String   @default("GM Design")
  phoneNumber String?  @default("(305) XXX-XXXX")
  address     String?
  logoUrl     String   @default("/logo.svg")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CabinetProviderSettings {
  id           String   @id @default(cuid())
  actualName   String
  displayName  String
  contactName  String?
  contactPhone String?
  contactEmail String?
  address      String?
  notes        String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([actualName])
  @@index([displayName])
  @@index([isActive])
}

model CabinetInstallerProfile {
  id         String                       @id @default(cuid())
  name       String
  code       String?                      @unique
  notes      String?
  costTierId String?
  isActive   Boolean                      @default(true)
  createdAt  DateTime                     @default(now())
  updatedAt  DateTime                     @updatedAt
  costTier   CabinetInstallationCostTier? @relation(fields: [costTierId], references: [id])

  @@unique([name])
  @@index([isActive])
  @@index([costTierId])
}

model CabinetInstallationItem {
  id                  String                       @id @default(cuid())
  code                String?                      @unique
  description         String
  category            String?
  defaultWillingToPay Decimal                      @db.Decimal(10, 2)
  salePrice           Decimal                      @default(0) @db.Decimal(10, 2)
  isActive            Boolean                      @default(true)
  createdAt           DateTime                     @default(now())
  updatedAt           DateTime                     @updatedAt
  costs               CabinetInstallationItemCost[]

  @@index([description])
  @@index([category])
  @@index([isActive])
}

model CabinetInstallationCostTier {
  id        String                       @id @default(cuid())
  key       String                       @unique
  name      String
  isActive  Boolean                      @default(true)
  sortOrder Int                          @default(0)
  createdAt DateTime                     @default(now())
  updatedAt DateTime                     @updatedAt
  profiles  CabinetInstallerProfile[]
  costs     CabinetInstallationItemCost[]

  @@index([isActive])
  @@index([sortOrder])
}

model CabinetInstallationItemCost {
  id         String                       @id @default(cuid())
  itemId     String
  costTierId String
  cost       Decimal                      @db.Decimal(10, 2)
  createdAt  DateTime                     @default(now())
  updatedAt  DateTime                     @updatedAt
  item       CabinetInstallationItem      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  costTier   CabinetInstallationCostTier  @relation(fields: [costTierId], references: [id], onDelete: Cascade)

  @@unique([itemId, costTierId])
  @@index([itemId])
  @@index([costTierId])
}

enum Role {
  ADMIN
  SALES
  OFFICE
  FINANCE
  SPECIALIST
  UNASSIGNED
  INSTALLER
}

enum SlabThickness {
  EIGHT_MM
  TWELVE_MM
  TWO_CM
  THREE_CM
  FIFTEEN_MM
}

enum SlabStatus {
  AVAILABLE
  DISCONTINUED
  UNAVAILABLE
}

enum SlabFinish {
  CONCRETE
  DUAL
  HONED
  LEATHER
  MATTE
  NATURAL
  OTHER
  POLISHED
  ROUGH
  STONE
  ULTRA_ROUGH
  SATIN
  SATIN_HONED
  PATINATO
  LEVIGATO_PEARL
  GLAM
  GINZA
  HOLOS
  TWILL
  JUTA
  DENIM
  DAMIER
  LAVA
  SILK
  LUXE
  BRUSHED
  TEXTURED
  SMOOTH_MATTE
  TEXTURED_MATTE
  VELVET
  TEXTURED_VELVET
  SATIN_RIDGE
  SUEDE
  DECOR_POLISHED
  NANOTECH_POLISHED
  NATURAL_TOUCH
  RIVERWASHED
  SLATE
  ULTRASOFT
}

enum ClosetAreaType {
  MASTER
  GUEST
  GARAGE
  KITCHEN
  WALL_UNIT
  LAUNDRY
  OTHER
}

enum ClosetJobStatus {
  QUOTE
  REVIEW
  APPROVED
  CANCELLED
}

enum ClosetQuoteStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum SampleRequestStatus {
  REQUESTED
  IN_PROGRESS
  ORDERED
  DELIVERED
  CANCELED
}

enum SampleRequestType {
  CABINET
  COUNTERTOP
}

// Customer Management - QuickBooks & Pipedrive Integration
model Customer {
  id                 String       @id @default(uuid())
  type               CustomerType @default(PROSPECT)
  quickbooksId       String?      @unique
  pipedriveId        String?      @unique
  companyCamId       String?
  syncedToQB         Boolean      @default(false)
  displayName        String
  companyName        String?
  givenName          String?
  familyName         String?
  email              String?
  phone              String?
  mobile             String?
  billAddr           Json?
  shipAddr           Json?
  salesPerson        String?
  balance            Decimal?     @db.Decimal(12, 2)
  lastSyncedAt       DateTime?
  quickbooksData     Json?
  pipedriveData      Json?
  notes              String?
  active             Boolean      @default(true)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  closetJobs         ClosetJob[]
  jobs               Job[]
  sampleRequests     SampleRequest[]

  @@index([quickbooksId])
  @@index([pipedriveId])
  @@index([displayName])
  @@index([email])
  @@index([type])
}

model Job {
  id                String    @id @default(uuid())
  jobNumber         Int       @unique @default(autoincrement())
  customerId        String
  jobName           String
  quickbooksJobId   String?   @unique
  pipedriveId       String?   @unique
  companyCamId      String?
  status            JobStatus @default(ONGOING)
  value             Decimal?  @db.Decimal(12, 2)
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  lastSyncedAt      DateTime?
  customer          Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  closetJob         ClosetJob?
  artifacts         JobArtifact[]
  accessoryTrackers AccessoryTracker[]
  sampleRequests    SampleRequest[]

  @@index([customerId])
  @@index([quickbooksJobId])
  @@index([pipedriveId])
  @@index([status])
  @@index([jobNumber])
}

model JobArtifact {
  id              String   @id @default(uuid())
  jobId           String
  sourceApp       String   // "CABINET_ESTIMATES", "SLABS", "CLOSET", "FILES", etc.
  type            String   // "LINK", "FILE", "NOTE", "SNAPSHOT"
  title           String
  url             String?  // Deep link to internal page or external resource
  fileStorageKey  String?  // For FILE type: storage key/path
  fileName        String?  // Original filename
  mimeType        String?  // File MIME type
  fileSize        Int?     // File size in bytes
  metadata        Json?    // Optional structured data snapshot
  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  job             Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([sourceApp])
  @@index([type])
}

model SampleRequestProvider {
  id            String            @id @default(cuid())
  name          String
  sampleType    SampleRequestType
  contactName   String?
  contactPhone  String?
  contactEmail  String?
  contactMethod String?
  notes         String?
  isActive      Boolean           @default(true)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@unique([name, sampleType])
  @@index([sampleType])
  @@index([isActive])
}

model SampleRequest {
  id                 String               @id @default(cuid())
  status             SampleRequestStatus  @default(REQUESTED)
  sampleType         SampleRequestType
  brand              String
  colorName          String
  quantity           Int                  @default(1)
  notes              String?
  jobId              String?
  job                Job?                 @relation(fields: [jobId], references: [id])
  customerId         String?
  customer           Customer?            @relation(fields: [customerId], references: [id])
  jobName            String?
  requestedByUserId  String?
  requestedByUser    User?                @relation("SampleRequestRequestedBy", fields: [requestedByUserId], references: [id])
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  history            SampleRequestHistory[]

  @@index([jobId])
  @@index([customerId])
  @@index([status])
  @@index([sampleType])
}

model SampleRequestHistory {
  id               String               @id @default(cuid())
  requestId        String
  request          SampleRequest        @relation(fields: [requestId], references: [id], onDelete: Cascade)
  fromStatus       SampleRequestStatus?
  toStatus         SampleRequestStatus?
  message          String?
  changedByUserId  String?
  changedByUser    User?                @relation("SampleRequestHistoryChangedBy", fields: [changedByUserId], references: [id])
  createdAt        DateTime             @default(now())

  @@index([requestId])
  @@index([createdAt])
}

enum CustomerType {
  PROSPECT
  CLIENT
  CONTRACTOR
}

enum JobStatus {
  ONGOING
  COMPLETE
  ON_HOLD
  CANCELLED
}

model QuickBooksTokens {
  id            String   @id @default(cuid())
  accessToken   String
  refreshToken  String
  expiresAt     DateTime
  realmId       String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model SyncJob {
  id            String   @id @default(cuid())
  type          String   @default("customer_sync")
  status        String   @default("running") // running, completed, cancelled, failed
  startedAt     DateTime @default(now())
  completedAt   DateTime?
  cancelledAt   DateTime?
  totalRecords  Int?
  processedRecords Int   @default(0)
  createdRecords   Int   @default(0)
  updatedRecords   Int   @default(0)
  errorCount       Int   @default(0)
  errorMessage     String?
  cancelRequested  Boolean @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// Accessories Tracker - Track accessory purchases for cabinet/countertop jobs
model AccessoryTracker {
  id                   String           @id @default(cuid())
  jobId                String
  job                  Job              @relation(fields: [jobId], references: [id], onDelete: Cascade)
  invoiceNumber        String?
  invoiceCreatedAt     DateTime?
  remeasureApprovedAt  DateTime?
  department           AccessoryDepartment?
  notes                String?
  isArchived           Boolean          @default(false)
  createdByUserId      String?
  updatedByUserId      String?
  createdByUser        User?            @relation("AccessoryTrackerCreatedBy", fields: [createdByUserId], references: [id])
  updatedByUser        User?            @relation("AccessoryTrackerUpdatedBy", fields: [updatedByUserId], references: [id])
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  items                AccessoryItem[]

  @@index([jobId])
}

model AccessoryItem {
  id                  String              @id @default(cuid())
  trackerId           String
  tracker             AccessoryTracker    @relation(fields: [trackerId], references: [id], onDelete: Cascade)
  category            AccessoryCategory
  name                String
  quantity            Int                 @default(1)
  sku                 String?
  vendor              String?
  linkUrl             String?
  cost                Decimal?            @db.Decimal(10, 2)
  retail              Decimal?            @db.Decimal(10, 2)
  status              AccessoryItemStatus @default(READY_TO_ORDER)
  priority            AccessoryPriority   @default(NORMAL)
  isArchived          Boolean             @default(false)
  orderedAt           DateTime?
  etaAt               DateTime?
  deliveredAt         DateTime?
  checkedInAt         DateTime?
  installedAt         DateTime?
  assignedToUserId    String?
  lastStatusChangedAt DateTime?
  createdByUserId     String?
  updatedByUserId     String?
  assignedToUser       User?              @relation("AccessoryItemAssignedTo", fields: [assignedToUserId], references: [id])
  createdByUser        User?              @relation("AccessoryItemCreatedBy", fields: [createdByUserId], references: [id])
  updatedByUser        User?              @relation("AccessoryItemUpdatedBy", fields: [updatedByUserId], references: [id])
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  events              AccessoryItemEvent[]

  @@index([trackerId])
  @@index([status])
  @@index([assignedToUserId])
}

model AccessoryItemEvent {
  id              String    @id @default(cuid())
  itemId          String
  item            AccessoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  type            AccessoryEventType
  fromStatus      AccessoryItemStatus?
  toStatus        AccessoryItemStatus?
  message         String?
  changedByUserId String?
  changedByUser   User?     @relation("AccessoryItemEventChangedBy", fields: [changedByUserId], references: [id])
  createdAt       DateTime  @default(now())

  @@index([itemId])
  @@index([createdAt])
}

enum AccessoryDepartment {
  CABINETS
  COUNTERTOPS
  BOTH
}

enum AccessoryCategory {
  INSERT_ITEM
  HANDLE
  PULLOUT
  TRIM
  HARDWARE
  SINK
  FAUCET
  APPLIANCE
  LIGHTING
  OTHER
}

enum AccessoryItemStatus {
  PENDING_REMEASURE_APPROVAL
  READY_TO_ORDER
  ORDERED
  IN_TRANSIT
  DELIVERED
  CHECKED_IN
  INSTALLED
  NOT_NEEDED
  ISSUE
}

enum AccessoryPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum AccessoryEventType {
  STATUS_CHANGE
  NOTE
  FIELD_EDIT
  CREATED
}
