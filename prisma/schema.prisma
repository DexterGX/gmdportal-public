generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                          String                 @id @default(cuid())
  name                        String?
  email                       String?                @unique
  emailVerified               DateTime?
  image                       String?
  username                    String?                @unique
  passwordHash                String?
  resetToken                  String?                @unique
  resetTokenExpiry            DateTime?
  role                        Role                   @default(UNASSIGNED)
  active                      Boolean                @default(false)
  roles                       String[]               @default([])
  accessoryItemsAssigned      AccessoryItem[]        @relation("AccessoryItemAssignedTo")
  accessoryItemsCreated       AccessoryItem[]        @relation("AccessoryItemCreatedBy")
  accessoryItemsUpdated       AccessoryItem[]        @relation("AccessoryItemUpdatedBy")
  accessoryItemEventsChanged  AccessoryItemEvent[]   @relation("AccessoryItemEventChangedBy")
  accessoryTrackersCreated    AccessoryTracker[]     @relation("AccessoryTrackerCreatedBy")
  accessoryTrackersUpdated    AccessoryTracker[]     @relation("AccessoryTrackerUpdatedBy")
  accounts                    Account[]
  approvedQuotes              ClosetQuote[]          @relation("ApprovedQuotes")
  installerQuotes             ClosetQuote[]          @relation("InstallerQuotes")
  submittedQuotes             ClosetQuote[]          @relation("SubmittedQuotes")
  sampleRequestsRequested     SampleRequest[]        @relation("SampleRequestRequestedBy")
  sampleRequestHistoryChanged SampleRequestHistory[] @relation("SampleRequestHistoryChangedBy")
  sessions                    Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model StockItem {
  id           String             @id @default(uuid())
  name         String
  category     String
  unit         String
  quantity     Int                @default(0)
  minQuantity  Int                @default(0)
  notes        String?
  updatedById  String?
  updatedAt    DateTime           @updatedAt
  providor     String?
  transactions StockTransaction[]
}

model StockTransaction {
  id          String    @id @default(uuid())
  itemId      String
  userId      String?
  change      Int
  reason      String?
  oldQuantity Int
  newQuantity Int
  createdAt   DateTime  @default(now())
  item        StockItem @relation(fields: [itemId], references: [id])
}

model SlabBrandConfig {
  id            String    @id @default(cuid())
  name          String
  gmdBrandId    String?
  profitFactor  Decimal   @db.Decimal(10, 4)
  taxRate       Decimal   @db.Decimal(5, 4)
  deliveryFee   Decimal   @db.Decimal(10, 2)
  discount      Decimal   @db.Decimal(10, 4)
  lastUpdate    DateTime? @db.Timestamptz(6)
  contactName   String?
  contactNumber String?
  contactCell   String?
  contactEmail  String?
  createdAt     DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(6)
  brandNumber   Int?      @unique
  logoUrl       String?
  slabs         Slab[]
  notes         SlabBrandNote[]
}

model SlabBrandNote {
  id         String          @id @default(cuid())
  brandId    String
  title      String
  content    String
  catalogUrl String?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  brand      SlabBrandConfig @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([brandId, createdAt])
}

model Slab {
  id            String          @id @default(cuid())
  gmdId         String?
  brandId       String
  series        String?
  providerCode  String
  color         String
  finish        SlabFinish
  status        SlabStatus      @default(AVAILABLE)
  providerPrice Decimal         @db.Decimal(10, 2)
  finalPrice    Decimal         @db.Decimal(10, 2)
  createdAt     DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime        @updatedAt @db.Timestamptz(6)
  heightIn      Decimal         @db.Decimal(6, 2)
  slabNumber    Int?            @unique
  thickness     SlabThickness
  widthIn       Decimal         @db.Decimal(6, 2)
  brand         SlabBrandConfig @relation(fields: [brandId], references: [id])
}

model SinkBrand {
  id           String   @id @default(cuid())
  name         String   @unique
  logoUrl      String?
  factor       Decimal  @default(1) @db.Decimal(10, 4)
  taxFactor    Decimal  @default(1) @db.Decimal(10, 4)
  freight      Decimal  @default(0) @db.Decimal(10, 2)
  discount     Decimal  @default(0) @db.Decimal(10, 4)
  contactName  String?
  contactCell  String?
  contactPhone String?
  contactEmail String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  sinks        Sink[]
  notes        SinkBrandNote[]
  modelImages  SinkModelImage[]
}

model SinkBrandNote {
  id          String    @id @default(cuid())
  brandId     String
  title       String
  content     String
  catalogUrl  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  brand       SinkBrand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([brandId, createdAt])
}

model Sink {
  id               String     @id @default(cuid())
  brandId          String
  series           String?
  model            String
  description      String?
  dimensions       String
  listedPrice      Decimal    @db.Decimal(10, 2)
  finalPrice       Decimal    @db.Decimal(10, 2)
  status           SinkStatus @default(AVAILABLE)
  isPromotional    Boolean    @default(false)
  promotionalPrice Decimal?   @db.Decimal(10, 2)
  imageUrl         String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  brand            SinkBrand  @relation(fields: [brandId], references: [id], onDelete: Restrict)

  @@unique([brandId, model, dimensions, description])
  @@index([brandId])
  @@index([status])
  @@index([isPromotional])
}

model SinkModelImage {
  id        String    @id @default(cuid())
  brandId   String
  model     String
  imageUrl  String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  brand     SinkBrand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@unique([brandId, model])
  @@index([brandId])
}

model SlabBayRack {
  id                   String        @id
  name                 String
  capacity             Int
  note                 String?
  countTowardInventory Boolean       @default(true)
  targetFill           Int           @default(5)
  slabs                SlabBaySlab[]
}

model SlabBaySlab {
  id         String      @id
  scannerId  String
  name       String
  type       String
  thickness  String
  size       String
  clientName String
  rackId     String
  createdAt  DateTime    @default(now())
  batchId    String?
  batchIndex Int?
  batchSize  Int?
  brand      String?
  finish     String?
  jobId      String?
  notes      String?
  rack       SlabBayRack @relation(fields: [rackId], references: [id])
}

model SlabBayHistory {
  id                     String  @id
  type                   String
  slabId                 String
  slabScannerId          String?
  slabName               String
  slabType               String
  clientName             String
  fromRack               String?
  toRack                 String?
  exitNote               String?
  userName               String
  timestamp              String
  batchId                String?
  batchIndex             Int?
  batchSize              Int?
  brand                  String?
  entryNote              String?
  finish                 String?
  jobId                  String?
  recoveredFromHistoryId String?
  slabCreatedAt          String?
  slabNotes              String?
  slabSize               String?
  slabThickness          String?
}

model ClosetJob {
  id              String          @id @default(uuid())
  quoteNumber     String          @unique
  customerName    String
  customerPhone   String?
  salesPersonId   String
  installerId     String
  propertyAddress String
  area            ClosetAreaType
  status          ClosetJobStatus @default(QUOTE)
  createdAt       DateTime        @default(now())
  quoteStartedAt  DateTime        @default(now())
  notesSales      String?
  customerId      String?
  jobId           String?         @unique
  areas           String[]        @default([])
  customer        Customer?       @relation(fields: [customerId], references: [id])
  job             Job?            @relation(fields: [jobId], references: [id])
  quotes          ClosetQuote[]
}

model ClosetQuote {
  id              String            @id @default(uuid())
  closetJobId     String
  quoteCode       String            @unique
  color           String
  installerCost   Decimal           @db.Decimal(12, 2)
  gmFactor        Decimal?          @db.Decimal(8, 4)
  finalPrice      Decimal           @db.Decimal(12, 2)
  notesInstaller  String?
  notesSales      String?
  status          ClosetQuoteStatus @default(PENDING_REVIEW)
  createdAt       DateTime          @default(now())
  submittedAt     DateTime?
  approvedAt      DateTime?
  approvedById    String?
  lastPrintedAt   DateTime?
  lastPrintedById String?
  installerId     String?
  submittedById   String?
  approvedBy      User?             @relation("ApprovedQuotes", fields: [approvedById], references: [id])
  closetJob       ClosetJob         @relation(fields: [closetJobId], references: [id], onDelete: Cascade)
  installer       User?             @relation("InstallerQuotes", fields: [installerId], references: [id])
  submittedBy     User?             @relation("SubmittedQuotes", fields: [submittedById], references: [id])
  files           ClosetQuoteFile[]
}

model ClosetQuoteFile {
  id            String      @id @default(uuid())
  closetQuoteId String
  fileUrl       String
  type          String
  caption       String?
  uploadedById  String
  uploadedAt    DateTime    @default(now())
  closetQuote   ClosetQuote @relation(fields: [closetQuoteId], references: [id], onDelete: Cascade)
}

model ClosetEstimateSettings {
  id                    String   @id @default(uuid())
  defaultGmFactor       Decimal  @db.Decimal(8, 4)
  quoteNumberFormat     String   @default("{INITIALS}-CQUO-{YYMMDD}-{SEQ3}")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  printCompanyLine1     String   @default("Custom Closets & Cabinetry")
  printCompanyLine2     String   @default("Miami, FL")
  printCompanyName      String   @default("GM Design")
  printCompanyPhone     String   @default("(305) XXX-XXXX")
  printHeaderTitle      String   @default("Closet Design & Installation Quote")
  printLogoUrl          String   @default("/logo.svg")
  printOverviewTemplate String   @default("Custom closet system for the {AREA} at {ADDRESS}, including design, materials, and professional installation as illustrated in the 3D views below.")
}

model CompanyDocumentSettings {
  id          String   @id @default(cuid())
  companyName String   @default("GM Design")
  phoneNumber String?  @default("(305) XXX-XXXX")
  email       String?
  website     String?
  address     String?
  logoUrl     String   @default("/logo.svg")
  showPrintGuides Boolean @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AgreementFormTemplate {
  id        String   @id @default(cuid())
  key       String   @unique
  title     String
  content   String
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
}

model CountertopAgreementImage {
  id          String   @id @default(cuid())
  category    String
  optionKey   String
  optionLabel String
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([category, optionKey])
  @@index([category])
}

model ProgramAccessSetting {
  id           String   @id @default(cuid())
  programId    String   @unique
  allowedRoles String[] @default([])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model SystemRoleSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  label     String
  isBuiltIn Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

model CabinetProviderSettings {
  id           String   @id @default(cuid())
  actualName   String   @unique
  displayName  String
  contactName  String?
  contactPhone String?
  contactEmail String?
  address      String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  notes        String?

  @@index([displayName])
  @@index([isActive])
}

model CabinetInstallerProfile {
  id         String                       @id @default(cuid())
  name       String                       @unique
  code       String?                      @unique
  notes      String?
  isActive   Boolean                      @default(true)
  createdAt  DateTime                     @default(now())
  updatedAt  DateTime                     @updatedAt
  costTierId String?
  costTier   CabinetInstallationCostTier? @relation(fields: [costTierId], references: [id])

  @@index([isActive])
  @@index([costTierId])
}

model CabinetInstallationItem {
  id                  String                        @id @default(cuid())
  code                String?                       @unique
  description         String
  category            String?
  defaultWillingToPay Decimal                       @db.Decimal(10, 2)
  isActive            Boolean                       @default(true)
  createdAt           DateTime                      @default(now())
  updatedAt           DateTime                      @updatedAt
  salePrice           Decimal                       @default(0) @db.Decimal(10, 2)
  costs               CabinetInstallationItemCost[]

  @@index([description])
  @@index([category])
  @@index([isActive])
}

model CabinetInstallationCostTier {
  id        String                        @id @default(cuid())
  key       String                        @unique
  name      String
  isActive  Boolean                       @default(true)
  sortOrder Int                           @default(0)
  createdAt DateTime                      @default(now())
  updatedAt DateTime                      @updatedAt
  costs     CabinetInstallationItemCost[]
  profiles  CabinetInstallerProfile[]

  @@index([isActive])
  @@index([sortOrder])
}

model CabinetInstallationItemCost {
  id         String                      @id @default(cuid())
  itemId     String
  costTierId String
  cost       Decimal                     @db.Decimal(10, 2)
  createdAt  DateTime                    @default(now())
  updatedAt  DateTime                    @updatedAt
  costTier   CabinetInstallationCostTier @relation(fields: [costTierId], references: [id], onDelete: Cascade)
  item       CabinetInstallationItem     @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, costTierId])
  @@index([itemId])
  @@index([costTierId])
}

model Customer {
  id                       String          @id @default(uuid())
  quickbooksId             String?         @unique
  displayName              String
  companyName              String?
  givenName                String?
  familyName               String?
  email                    String?
  phone                    String?
  mobile                   String?
  billAddr                 Json?
  shipAddr                 Json?
  balance                  Decimal?        @db.Decimal(12, 2)
  lastSyncedAt             DateTime?
  quickbooksData           Json?
  notes                    String?
  active                   Boolean         @default(true)
  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @updatedAt
  companyCamId             String?
  pipedriveData            Json?
  pipedriveId              String?         @unique
  syncedToQB               Boolean         @default(false)
  type                     CustomerType    @default(PROSPECT)
  salesPerson              String?
  referredByOrgPipedriveId String?
  referredByOrgName        String?
  closetJobs               ClosetJob[]
  jobs                     Job[]
  sampleRequests           SampleRequest[]

  @@index([quickbooksId])
  @@index([pipedriveId])
  @@index([displayName])
  @@index([email])
  @@index([type])
  @@index([referredByOrgPipedriveId])
}

model Job {
  id                String             @id @default(uuid())
  customerId        String
  jobName           String
  quickbooksJobId   String?            @unique
  pipedriveId       String?            @unique
  companyCamId      String?
  status            JobStatus          @default(ONGOING)
  value             Decimal?           @db.Decimal(12, 2)
  notes             String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  lastSyncedAt      DateTime?
  jobNumber         Int                @unique @default(autoincrement())
  jobType           String?
  companyCamUrl     String?
  quickbooksUrl     String?
  stageId           Int?
  closeDate         DateTime?          @db.Timestamptz(6)
  expectedCloseDate DateTime?          @db.Date
  propertyAddress   String?
  dealTitle         String?
  accessoryTrackers AccessoryTracker[]
  closetJob         ClosetJob?
  customer          Customer           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  artifacts         JobArtifact[]
  sampleRequests    SampleRequest[]

  @@index([customerId])
  @@index([quickbooksJobId])
  @@index([pipedriveId])
  @@index([status])
  @@index([jobNumber])
  @@index([jobType])
}

model JobArtifact {
  id              String   @id @default(uuid())
  jobId           String
  sourceApp       String
  type            String
  title           String
  url             String?
  fileStorageKey  String?
  fileName        String?
  mimeType        String?
  fileSize        Int?
  metadata        Json?
  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  job             Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([sourceApp])
  @@index([type])
}

model MiscEstimate {
  id          String               @id @default(cuid())
  estimateNo  String?              @unique
  title       String
  clientName  String?
  clientId    String?
  dealName    String?
  dealId      String?
  date        DateTime
  salesRep    String
  status      String               @default("DRAFT")
  subtotal    Decimal              @default(0) @db.Decimal(12, 2)
  discount    Decimal              @default(0) @db.Decimal(12, 2)
  total       Decimal              @default(0) @db.Decimal(12, 2)
  createdById String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  ledRows     MiscEstimateLedRow[]
  ledSheetRows MiscEstimateLedSheetRow[]
  glassDoorShelfRows MiscEstimateGlassDoorShelfRow[]
  mirrorRows  MiscEstimateMirrorRow[]
  islandPanelRows MiscEstimateIslandPanelRow[]
  wallUnitRows MiscEstimateWallUnitRow[]
  mirrorFrameRows MiscEstimateMirrorFrameRow[]
  mirrorRemovalRows MiscEstimateMirrorRemovalRow[]

  @@index([estimateNo])
  @@index([clientId])
  @@index([dealId])
}

model MiscEstimateLedSheetRow {
  id            String              @id @default(cuid())
  estimateId    String
  estimate      MiscEstimate        @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  roomId        String?
  room          MiscLedRoom?        @relation(fields: [roomId], references: [id], onDelete: SetNull)
  sheetTypeId   String?
  sheetType     MiscLedSheetType?   @relation(fields: [sheetTypeId], references: [id])
  controlTypeId String?
  controlType   MiscLedControlType? @relation(fields: [controlTypeId], references: [id])
  widthIn       Decimal             @default(0) @db.Decimal(12, 2)
  heightIn      Decimal             @default(0) @db.Decimal(12, 2)
  squareFeet    Int                 @default(0)
  subtotal      Decimal             @default(0) @db.Decimal(12, 2)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([estimateId])
  @@index([roomId])
  @@index([sheetTypeId])
  @@index([controlTypeId])
}

model MiscEstimateGlassDoorShelfRow {
  id            String                 @id @default(cuid())
  estimateId    String
  estimate      MiscEstimate           @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  glassTypeId   String?
  glassType     MiscGlassDoorShelfType? @relation(fields: [glassTypeId], references: [id], onDelete: SetNull)
  widthIn       Decimal                @default(0) @db.Decimal(12, 2)
  heightIn      Decimal                @default(0) @db.Decimal(12, 2)
  squareFeet    Decimal                @default(0) @db.Decimal(12, 2)
  quantity      Int                    @default(0)
  note          String?
  subtotal      Decimal                @default(0) @db.Decimal(12, 2)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  @@index([estimateId])
  @@index([glassTypeId])
}

model MiscEstimateMirrorRow {
  id            String           @id @default(cuid())
  estimateId    String
  estimate      MiscEstimate     @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  roomId        String?
  room          MiscLedRoom?     @relation(fields: [roomId], references: [id], onDelete: SetNull)
  colorId       String?
  color         MiscMirrorColor? @relation(fields: [colorId], references: [id])
  beveledOptionId String?
  beveledOption MiscMirrorBevelOption? @relation(fields: [beveledOptionId], references: [id])
  widthIn       Decimal          @default(0) @db.Decimal(12, 2)
  heightIn      Decimal          @default(0) @db.Decimal(12, 2)
  squareFeet    Decimal          @default(0) @db.Decimal(12, 2)
  outlets       Int              @default(0)
  lightCutouts  Int              @default(0)
  beveled       Boolean          @default(false)
  note          String?
  subtotal      Decimal          @default(0) @db.Decimal(12, 2)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([estimateId])
  @@index([roomId])
  @@index([colorId])
  @@index([beveledOptionId])
}

model MiscEstimateIslandPanelRow {
  id            String            @id @default(cuid())
  estimateId    String
  estimate      MiscEstimate      @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  roomId        String?
  room          MiscLedRoom?      @relation(fields: [roomId], references: [id], onDelete: SetNull)
  panelModelId  String?
  panelModel    MiscIslandPanelModel? @relation(fields: [panelModelId], references: [id], onDelete: SetNull)
  widthIn       Decimal           @default(0) @db.Decimal(12, 2)
  heightIn      Decimal           @default(0) @db.Decimal(12, 2)
  squareFeet    Decimal           @default(0) @db.Decimal(12, 2)
  boxQty        Int               @default(0)
  subtotal      Decimal           @default(0) @db.Decimal(12, 2)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([estimateId])
  @@index([roomId])
  @@index([panelModelId])
}

model MiscEstimateWallUnitRow {
  id            String       @id @default(cuid())
  estimateId    String
  estimate      MiscEstimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  roomId        String?
  room          MiscLedRoom? @relation(fields: [roomId], references: [id], onDelete: SetNull)
  widthIn       Decimal      @default(0) @db.Decimal(12, 2)
  heightIn      Decimal      @default(0) @db.Decimal(12, 2)
  squareFeet    Decimal      @default(0) @db.Decimal(12, 2)
  note          String?
  subtotal      Decimal      @default(0) @db.Decimal(12, 2)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([estimateId])
  @@index([roomId])
}

model MiscEstimateMirrorFrameRow {
  id            String                 @id @default(cuid())
  estimateId    String
  estimate      MiscEstimate           @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  roomId        String?
  room          MiscLedRoom?           @relation(fields: [roomId], references: [id], onDelete: SetNull)
  finishId      String?
  finish        MiscMirrorFrameFinish? @relation(fields: [finishId], references: [id], onDelete: SetNull)
  widthIn       Decimal                @default(0) @db.Decimal(12, 2)
  heightIn      Decimal                @default(0) @db.Decimal(12, 2)
  linearInches  Decimal                @default(0) @db.Decimal(12, 2)
  painted       Boolean                @default(false)
  color         String?
  subtotal      Decimal                @default(0) @db.Decimal(12, 2)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  @@index([estimateId])
  @@index([roomId])
  @@index([finishId])
}

model MiscEstimateMirrorRemovalRow {
  id                 String       @id @default(cuid())
  estimateId         String
  estimate           MiscEstimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  widthIn            Decimal      @default(0) @db.Decimal(12, 2)
  heightIn           Decimal      @default(0) @db.Decimal(12, 2)
  squareFeet         Decimal      @default(0) @db.Decimal(12, 2)
  repairWall         Boolean      @default(false)
  subtotal           Decimal      @default(0) @db.Decimal(12, 2)
  repairWallSubtotal Decimal      @default(0) @db.Decimal(12, 2)
  total              Decimal      @default(0) @db.Decimal(12, 2)
