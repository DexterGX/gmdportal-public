  // AI couldn't confidently match is left blank rather than guessed.
  installationItemId String?
  installationItem    CabinetInstallationServiceItem? @relation(fields: [installationItemId], references: [id])

  prices    CabinetCatalogItemPrice[]
  lineItems CabinetEstimateLineItem[]

